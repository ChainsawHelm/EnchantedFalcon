# Enchanted Falcon — Now Playing Screen (WPS)
# Target: iPod Classic 7G (320x240 LCD)
#
# Rockbox WPS reference: https://www.rockbox.org/wiki/CustomWPS
#
# Tags used:
#   %V  - viewport definition (x,y,width,height,font)
#   %Cl - album art display (x,y,width,height,h-align,v-align)
#   %it - track title
#   %ia - track artist
#   %id - track album
#   %pc - current position
#   %pt - total time
#   %pb - progress bar
#   %bl - battery level
#   %s  - scroll
#   %ac - align center
#   %ar - align right

# --- Album Art (centered, large) ---
%V(40,10,240,180,-)
%Cl(0,0,240,180,c,c)

# --- Track Title (below art) ---
%V(10,195,300,18,-)
%ac%s%it

# --- Artist - Album ---
%V(10,215,300,15,-)
%ac%s%ia - %id

# --- Progress Bar ---
%V(20,192,280,3,-)
%pb(0,0,280,3,-)

# --- Time (left: elapsed, right: total) ---
%V(20,233,280,10,-)
%al%pc%ar%pt

# --- Battery (top right) ---
%V(280,2,40,12,-)
%ar%bl%%
