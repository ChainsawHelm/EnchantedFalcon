#! rockbox/tagbrowser/2.0
# Enchanted Falcon — iPod-style music navigation
#
# Replaces Rockbox's "Database" menu with the classic iPod layout:
#   Playlists → Artists → Albums → Songs → Genres
#   + Shuffle Songs at the bottom
#
# This file goes to /.rockbox/tagnavi_custom.config
# and is included by the main tagnavi.config

# === iPod-style main music menu ===
# Simplified: no composer, no year, no first-letter, no runtime stats
# Just the essentials, in iPod order

%menu_start "main" "Music"
"Artists"        -> albumartist -> album -> title = "fmt_title"
"Albums"         -> album -> title = "fmt_title"
"Songs"          -> title = "fmt_title"
"Genres"         -> genre -> albumartist -> album -> title = "fmt_title"
"Shuffle Songs"  ~> title = "fmt_title"

%root_menu "main"
