# Enchanted Falcon — Now Playing (WPS)
# iPod Classic 7G — 320x240
#
# Design: Dark, minimal. Large album art centered.
# Track info below. Thin progress bar. Subtle status.

# Disable built-in status bar
%wd

# Load backdrop
%X(backdrop.bmp)

# Load additional font for header
%Fl(2,18-Adobe-Helvetica-Bold.fnt)
%Fl(3,14-Adobe-Helvetica-Bold.fnt)

# Preload images
%xl(B,battery.bmp,0,0,10)
%xl(F,playmode.bmp,0,0,5)

# --- Album Art / No Art conditional ---
%?C<%Vd(a)|%Vd(b)>

# --- Album Art viewport ---
%ax%Vl(a,60,8,200,160,-)
%Cl(0,0,200,160,c,c)
%Cd

# --- No Art: Show track info large in center ---
%ax%Vl(b,20,30,280,140,2)
%ac%s%?it<%it|%fn>
%ac%s%?ia<%ia|>
%ac%s%?id<%id|>

# --- Progress bar ---
%V(20,172,280,4,-)
%pb(0,0,280,4,pb-fill.bmp)

# --- Time elapsed / total ---
%V(20,178,280,14,3)
%al%pc%ar%pt

# --- Track title (below progress) ---
%V(10,194,300,20,2)
%ac%s%?it<%it|%fn>

# --- Artist ---
%V(10,216,300,16,1)
%ac%s%?ia<%ia|>

# --- Playback mode icon (bottom left) ---
%V(4,220,16,12,-)
%?mp<%xd(Fa)|%xd(Fb)|%xd(Fc)|%xd(Fd)|%xd(Fe)>

# --- Battery (top right) ---
%V(296,4,20,10,-)
%?bl<%xd(Ba)|%xd(Bb)|%xd(Bc)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)>
