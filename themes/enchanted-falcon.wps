# Enchanted Falcon — Now Playing Screen (WPS)
# Target: iPod Classic 5.5G (220x176) / 6G (320x240)
#
# Rockbox WPS reference: https://www.rockbox.org/wiki/CustomWPS
#
# This is a starting point — the WPS markup language controls
# what's shown on the Now Playing screen.

# Preload images
%xl(A,album_art.bmp,0,0)

# Viewport: Album Art (centered, large)
%V(10,5,200,140,-)
%Cl(0,0,200,140,c,c)

# Viewport: Track Info (bottom)
%V(10,148,200,28,-)
%ac%s%it
%ac%s%ia

# Viewport: Progress Bar
%V(10,145,200,2,-)
%pb(0,0,200,2,progressbar.bmp)

# Viewport: Status (top-right, minimal)
%V(180,2,40,12,-)
%ar%bl%%
