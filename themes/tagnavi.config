#! rockbox/tagbrowser/2.0
# Enchanted Falcon — iPod-style music navigation
#
# Clean, simple hierarchy matching the classic iPod:
#   Artists → Albums → Songs → Genres → Shuffle Songs

# Track display format
%format "fmt_title"       "%s - %02d:%02d (%s)" basename Lm Ls filename ? title == "[Untagged]"
%format "fmt_title"       "%d.%02d. %s - %02d:%02d" discnum tracknum title Lm Ls ? discnum > "0"
%format "fmt_title"       "%02d. %s - %02d:%02d" tracknum title Lm Ls ? tracknum > "0"
%format "fmt_title"       "%s - %02d:%02d" title Lm Ls

# === iPod Music Menu ===
%menu_start "main" "Music"
"Artists"        -> albumartist -> album -> title = "fmt_title"
"Albums"         -> album -> title = "fmt_title"
"Songs"          -> title = "fmt_title"
"Genres"         -> genre -> albumartist -> album -> title = "fmt_title"
"Shuffle Songs"  ~> title = "fmt_title"

%root_menu "main"
